# Copie este arquivo para .env e preencha os valores locais.
# .env nunca deve ser commitado (já está no .gitignore).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitta_dev?schema=public"

# Gere um valor novo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-um-valor-gerado-localmente"

# Login social Google (specs/05-arquitetura.md, "Login social Google") —
# gerar no Google Cloud Console: APIs e Serviços > Credenciais > Criar
# credenciais > ID do cliente OAuth, tipo "Aplicativo da Web", com a URI de
# redirecionamento http://localhost:3000/api/auth/callback/google em dev
# (na Vercel, a URL real do deploy). Sem essas duas variáveis preenchidas,
# o botão "Google" do login existe e não quebra o app, mas o fluxo de
# verdade falha ao tentar entrar.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
